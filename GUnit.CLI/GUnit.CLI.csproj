<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <PackAsTool>true</PackAsTool>
    <ToolCommandName>gunit</ToolCommandName>

    <PackageId>GUnit.CLI</PackageId>
    <Version>0.3.1</Version>
    <Authors>Samuel Matarese</Authors>
    <Description>Godot testing framework</Description>
    <PackageTags>godot testing unit-test</PackageTags>

    <RepositoryUrl>https://github.com/samuelmatarese/GUnit</RepositoryUrl>
    <PackageProjectUrl>https://github.com/samuelmatarese/GUnit</PackageProjectUrl>

    <PackageLicenseExpression>MIT</PackageLicenseExpression>

    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>
</Project>
