<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <PackAsTool>true</PackAsTool>
    <ToolCommandName>gunit</ToolCommandName>

    <PackageId>GUnit.CLI</PackageId>
    <Version>0.4.3</Version>
    <Authors>Samuel Matarese</Authors>
    <Description>Godot testing framework</Description>
    <PackageTags>godot testing unit-test</PackageTags>

    <RepositoryUrl>https://github.com/samuelmatarese/GUnit</RepositoryUrl>
    <PackageProjectUrl>https://github.com/samuelmatarese/GUnit</PackageProjectUrl>

    <PackageLicenseExpression>MIT</PackageLicenseExpression>

    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeReferencedProjects>true</IncludeReferencedProjects>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../GUnit.Shared/GUnit.Shared.csproj">
      <PrivateAssets>all</PrivateAssets>
    </ProjectReference>
  </ItemGroup>
</Project>
